		thisapp.calculateStatistics(mrPre,mrPost)
	);

	// =====================================================
	// INFLAMMATION REGULATION
	// =====================================================

	irPre = List();
	irPost = List();

	for each participant in eligibleParticipants
	{
		if(eligibleIDs.contains(participant.ID))
		{
			pre = Vitality_Snapshots[
				Participant == participant &&
