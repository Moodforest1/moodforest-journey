map getOutcomesAverages()
{
		returnMap = Map();

	// =====================================================
	// LOAD ELIGIBLE PARTICIPANTS
	// =====================================================

	eligibleParticipants = Participant_Master[
		Outcome_Report_Eligible.contains("Yes")
	];

	eligibleIDs = List();

	for each p in eligibleParticipants
	{
		preRec = Vitality_Snapshots[
			Participant == p &&
			Review_Status == "Approved" &&
			Assessment_Phase == "Pre"
		];

		postRec = Vitality_Snapshots[
			Participant == p &&
			Review_Status == "Approved" &&
			Assessment_Phase == "Post"
		];

		if(preRec.count() > 0 && postRec.count() > 0)
		{
			eligibleIDs.add(p.ID);
		}
	}

	// =====================================================
	// LOAD SNAPSHOTS
	// =====================================================

	preSnapshots = Vitality_Snapshots[
		Review_Status == "Approved" &&
		Assessment_Phase == "Pre" &&
		Participant in eligibleIDs
	];

	postSnapshots = Vitality_Snapshots[
		Review_Status == "Approved" &&
		Assessment_Phase == "Post" &&
		Participant in eligibleIDs
	];

	followupSnapshots = Vitality_Snapshots[
		Review_Status == "Approved" &&
		Assessment_Phase == "Followup" &&
		Participant in eligibleIDs
	];

	// =====================================================
	// BASIC COUNTS
	// =====================================================

	returnMap.put("preCount",preSnapshots.count());
	returnMap.put("postCount",postSnapshots.count());
	returnMap.put("followupCount",followupSnapshots.count());
	/* PRE MQ */
	preTotalMQ = 0;
	preMQCount = 0;
	for each  s in preSnapshots
	{
		if(s.Mind_Flow_Score != null)
		{
			preTotalMQ = preTotalMQ + s.Mind_Flow_Score;
			preMQCount = preMQCount + 1;
		}
	}
	if(preMQCount > 0)
	{
		returnMap.put("preMQ",(preTotalMQ / preMQCount).round(1));
	}
	/* POST MQ */
	postTotalMQ = 0;
	postMQCount = 0;
	for each  s in postSnapshots
	{
		if(s.Mind_Flow_Score != null)
		{
			postTotalMQ = postTotalMQ + s.Mind_Flow_Score;
			postMQCount = postMQCount + 1;
		}
	}
	if(postMQCount > 0)
	{
		returnMap.put("postMQ",(postTotalMQ / postMQCount).round(1));
	}
	/* FOLLOWUP MQ */
	followupTotalMQ = 0;
	followupMQCount = 0;
	for each  s in followupSnapshots
	{
		if(s.Mind_Flow_Score != null)
		{
			followupTotalMQ = followupTotalMQ + s.Mind_Flow_Score;
			followupMQCount = followupMQCount + 1;
		}
	}
	if(followupMQCount > 0)
	{
		returnMap.put("followupMQ",(followupTotalMQ / followupMQCount).round(1));
	}
	participantList = List();
	for each  s in preSnapshots
	{
		if(!participantList.contains(s.Participant.ID))
		{
			participantList.add(s.Participant.ID);
		}
	}
	returnMap.put("participantCount",participantList.size());
	/* PRE BV */
	preTotalBV = 0;
	preBVCount = 0;
	for each  s in preSnapshots
	{
		if(s.Body_Vitality_Score != null)
		{
			preTotalBV = preTotalBV + s.Body_Vitality_Score;
			preBVCount = preBVCount + 1;
		}
	}
	if(preBVCount > 0)
	{
		returnMap.put("preBV",(preTotalBV / preBVCount).round(1));
	}
	/* POST BV */
	postTotalBV = 0;
	postBVCount = 0;
	for each  s in postSnapshots
	{
		if(s.Body_Vitality_Score != null)
		{
			postTotalBV = postTotalBV + s.Body_Vitality_Score;
			postBVCount = postBVCount + 1;
		}
	}
	if(postBVCount > 0)
	{
		returnMap.put("postBV",(postTotalBV / postBVCount).round(1));
	}
	/* FOLLOWUP BV */
	followupTotalBV = 0;
	followupBVCount = 0;
	for each  s in followupSnapshots
	{
		if(s.Body_Vitality_Score != null)
		{
			followupTotalBV = followupTotalBV + s.Body_Vitality_Score;
			followupBVCount = followupBVCount + 1;
		}
	}
	if(followupBVCount > 0)
	{
		returnMap.put("followupBV",(followupTotalBV / followupBVCount).round(1));
	}
	/* =========================================
COGNITIVE CLARITY
========================================= */
	preTotal = 0;
	preCountMetric = 0;
	for each  s in preSnapshots
	{
		if(s.Cognitive_Clarity != null)
		{
			preTotal = preTotal + s.Cognitive_Clarity;
			preCountMetric = preCountMetric + 1;
		}
	}
	if(preCountMetric > 0)
	{
		returnMap.put("preCognitive",(preTotal / preCountMetric).round(1));
	}
	postTotal = 0;
	postCountMetric = 0;
	for each  s in postSnapshots
	{
		if(s.Cognitive_Clarity != null)
		{
			postTotal = postTotal + s.Cognitive_Clarity;
			postCountMetric = postCountMetric + 1;
		}
	}
	if(postCountMetric > 0)
	{
		returnMap.put("postCognitive",(postTotal / postCountMetric).round(1));
	}
	followupTotal = 0;
	followupCountMetric = 0;
	for each  s in followupSnapshots
	{
		if(s.Cognitive_Clarity != null)
		{
			followupTotal = followupTotal + s.Cognitive_Clarity;
			followupCountMetric = followupCountMetric + 1;
		}
	}
	if(followupCountMetric > 0)
	{
		returnMap.put("followupCognitive",(followupTotal / followupCountMetric).round(1));
